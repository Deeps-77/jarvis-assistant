# ── Telegram ────────────────────────────────────────
# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram user IDs allowed to chat.
# The FIRST id becomes the bot owner (allowed to use /logs).
# Leave empty to allow anyone (NOT recommended).
ALLOWED_TELEGRAM_IDS=123456789

# ── Models ──────────────────────────────────────────
# Chat model served by Ollama (see: ollama list).
# Must support tool calling.
OLLAMA_MODEL=hf.co/LiquidAI/LFM2.5-2.6B-GGUF:latest

# Embedding model used for long-term memory.
EMBED_MODEL=nomic-embed-text

# ── Long-term memory tuning ─────────────────────────
# Max recalled old exchanges per query.
MEMORY_TOP_K=4
# Cosine similarity floor for recalling an exchange.
MEMORY_MIN_SIMILARITY=0.55
# Per-chat eviction cap (oldest dropped first).
MEMORY_MAX_PER_CHAT=500

# ── Document RAG tuning ─────────────────────────────
DOCS_TOP_K=4
DOCS_MIN_SIMILARITY=0.35

# ── Voice transcription (optional) ──────────────────
# Local faster-whisper. Small is the best balance.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ── Chainlit web UI (optional) ──────────────────────
# Run with: python app.py   → http://localhost:8000
# Web access is fail-closed: if no password is set nobody can log in.
CHAINLIT_USERNAME=webuser
CHAINLIT_PASSWORD=
# Optional overrides (defaults shown):
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=8000

# ── HTTPS for LAN mic access (optional) ─────────────
# true = auto-generate a self-signed certificate so the browser mic works
# when the UI is opened from other devices (http://LAN-IP blocks microphones).
# First visit per device: accept the "not private" certificate warning once.
CHAINLIT_TLS=false
# Optional overrides (defaults shown):
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=8000

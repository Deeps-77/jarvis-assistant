# ── Telegram ────────────────────────────────────────
# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram user IDs allowed to chat.
# The FIRST id becomes the bot owner (allowed to use /logs).
# Leave empty to allow anyone (NOT recommended).
ALLOWED_TELEGRAM_IDS=123456789

# ── Models ──────────────────────────────────────────
# Chat model served by Ollama (see: ollama list).
# Must support tool calling.
OLLAMA_MODEL=hf.co/LiquidAI/LFM2.5-2.6B-GGUF:latest

# Embedding model used for long-term memory.
EMBED_MODEL=nomic-embed-text

# ── Long-term memory tuning ─────────────────────────
# Max recalled facts per query.
MEMORY_TOP_K=4
# Cosine similarity floor for recalling a fact.
MEMORY_MIN_SIMILARITY=0.55
# Per-chat eviction cap (oldest dropped first).
MEMORY_MAX_PER_CHAT=500
# Model used to distill durable facts from each exchange.
# Empty = reuse the main OLLAMA_MODEL.
MEMORY_EXTRACT_MODEL=
# Max facts captured per exchange, and per-fact length cap.
MEMORY_MAX_FACTS_PER_TURN=10
MEMORY_MAX_FACT_CHARS=200

# ── Injection guard ─────────────────────────────────
# Scans web/document text for prompt-injection patterns before it reaches
# the model, redacts flagged spans, and tags external text as untrusted.
# Also quarantines suspicious auto-extracted memories. true/false.
INJECTION_GUARD=true

# ── Document RAG tuning ─────────────────────────────
DOCS_TOP_K=4
DOCS_MIN_SIMILARITY=0.35

# ── Voice transcription (optional) ──────────────────
# Local faster-whisper. Small is the best balance.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ── Vision (optional, for image understanding) ──────
# Any Ollama vision model. granite is doc/screenshot-focused;
# qwen2.5vl:3b balances documents + scenery; moondream2 is lightest.
OLLAMA_VISION_MODEL=granite3.2-vision:2b
# Unloads the vision model after idle time to free memory.
OLLAMA_VISION_KEEP_ALIVE=10m
# Context window for the vision model (raise if large/cropped images get rejected).
# OLLAMA_VISION_CTX=16384

# ── Chainlit web UI (optional) ──────────────────────
# Run with: python app.py   → http://localhost:8000
# Web access is fail-closed: if no password is set nobody can log in.
CHAINLIT_USERNAME=webuser
CHAINLIT_PASSWORD=
# Optional overrides (defaults shown):
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=8000

# ── HTTPS for LAN mic access (optional) ─────────────
# true = auto self-signed certificate + automatic http→https redirect.
# Web UI moves to https://localhost:8443 (CHAINLIT_TLS_PORT); old
# http://localhost:8000 links keep working by redirecting.
# Mic requires accepting the one-time certificate warning per device.
CHAINLIT_TLS=false
# CHAINLIT_TLS_PORT=8443
# Optional overrides (defaults shown):
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=8000

# ── Code Assistant (Phase 0) ────────────────────────
# Independent of the chat brain — picked up by `code_ui.py` (Phase 1+).
# Provider: "ollama" (default, local) or "openai" (cloud, requires API key).
CODE_LLM_PROVIDER=ollama
# Any tool-calling model that fits your hardware. 3B is the recommended
# minimum for plan-mode discipline; 7B and up are noticeably better at
# refactors.
CODE_LLM_MODEL=qwen2.5-coder:3b-instruct-q4_K_M
CODE_LLM_TEMPERATURE=0.1
CODE_LLM_NUM_CTX=16384
CODE_LLM_TIMEOUT=600
CODE_LLM_KEEP_ALIVE=-1
# CODE_LLM_MAX_TOKENS=4096
# CODE_LLM_BASE_URL=http://localhost:11434
# OpenAI only — leave CODE_LLM_PROVIDER=ollama above to disable.
# CODE_LLM_API_KEY=sk-...
# CODE_LLM_BASE_URL=https://api.openai.com/v1

# Code Assistant UI (Phase 1+)
# CODE_UI_HOST=0.0.0.0
# CODE_UI_PORT=8500
# Optional: a folder the UI opens by default. Leave empty to show the
# workspace picker on every chat start.
# CODE_DEFAULT_WORKSPACE=
# Subprocess sandbox timeout (seconds) used by run_command.
# CODE_SANDBOX_TIMEOUT=30
# Max in-memory turns kept by TokenTracker before dropping the oldest
# (the JSONL log on disk always keeps the full history).
# CODE_TOKEN_HISTORY=1000

# Code Assistant auth (Phase 1) — INDEPENDENT from CHAINLIT_PASSWORD so the
# chat UI and code UI can have separate credentials. Fail-closed: if no
# password is set nobody can log in.
CHAINLIT_CODE_USERNAME=codeuser
CHAINLIT_CODE_PASSWORD=

# ── Optional: route the CHAT brain through the same provider ──
# When true, `core.py` uses llm_provider.LLMConfig.from_env("") instead
# of reading OLLAMA_MODEL directly. Leave false to keep current behaviour.
# USE_SHARED_LLM_CONFIG=false
